
SELECT order_id 
FROM Orders 
WHERE product_name = 'cake' AND requires_gift_wrap = TRUE;


SELECT order_date 
FROM Orders 
WHERE city = 'Moscow' AND assembly_days <= 2;


DROP TABLE IF EXISTS Moscow_Fast_Orders; 
SELECT order_date, delivery_address, assembly_days, order_id 
INTO Moscow_Fast_Orders 
FROM Orders 
WHERE city = 'Moscow' AND assembly_days <= 2;


INSERT INTO Moscow_Fast_Orders (order_date, delivery_address, assembly_days, order_id)
SELECT order_date, delivery_address, assembly_days, order_id
FROM Orders
WHERE packages_count > 20;


UPDATE Moscow_Fast_Orders 
SET assembly_days = assembly_days + 2
WHERE EXTRACT(MONTH FROM order_date) IN (6, 7, 8);


DELETE FROM Orders 
WHERE order_id = 1;


SELECT 
    COUNT(*) AS total_orders,              
    SUM(packages_count) AS total_packages, 
    AVG(assembly_days) AS avg_assembly,    
    MIN(order_date) AS first_order,      
    MAX(order_date) AS last_order          
FROM Orders;
