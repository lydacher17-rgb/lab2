CREATE TABLE Orders (
    order_id SERIAL PRIMARY KEY,              -- Номер заказа
    order_date DATE NOT NULL,                 -- Дата заказа
    city VARCHAR(100) NOT NULL,               -- Город
    delivery_address VARCHAR(255) NOT NULL,   -- Адрес доставки
    assembly_days INTEGER NOT NULL,           -- Срок сборки (дней)
    product_name VARCHAR(100) NOT NULL,       -- Название товара
    requires_gift_wrap BOOLEAN DEFAULT FALSE, -- Нужна ли подарочная упаковка (True/False)
    packages_count INTEGER DEFAULT 1          -- Количество упаковок
);


